---
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header.astro';
import Hero from '@/components/sections/Hero.astro';
import Contact from '@/components/sections/Contact.astro';
import Skills from '@/components/sections/Skills.astro';
import SectionAnimations from '@/components/SectionAnimations.astro';
import { fade } from 'astro:transitions';
---

<Layout
  title="Daniel Miranda | Full Stack Developer"
  description="Flutter and Full Stack developer with Next.js, NestJS, and Node.js. I build scalable mobile and web applications from Bolivia."
>
  <div class="min-h-screen bg-background" transition:animate={fade({ duration: '0.32s' })}>
    <Header />
    <main class="container mx-auto px-4 max-w-6xl">
      <section id="inicio" data-animate="section" class="min-h-[100dvh] flex items-center justify-center py-12 md:pt-28 md:pb-12 px-2">
        <Hero lang="en" />
      </section>
      
      <section id="habilidades" data-animate="section" class="min-h-[100dvh] flex items-center justify-center py-12 md:py-4">
          <Skills lang="en" />
      </section>
      
      <section id="contacto" data-animate="section" class="min-h-[100dvh] flex items-center justify-center py-12 md:py-4">
          <Contact lang="en" />
      </section>
    </main>
  </div>
</Layout>

<SectionAnimations />
