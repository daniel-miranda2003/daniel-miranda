---
import ThemeToggle from '@/components/ThemeToggle.astro';
import LanguageSwitcher from '@/components/LanguageSwitcher.astro';
import { useTranslations } from '@/i18n/utils';
import { getLangFromUrl } from '@/i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<header id="header" class="flex fixed top-6 left-1/2 -translate-x-1/2 z-[100]">
  <nav id="desktop-nav" class="nav-glass-transition flex items-center gap-1 px-2 py-2 rounded-full whitespace-nowrap">
    <ul class="hidden md:flex items-center gap-0.5">
      <li><a href="#home" class="nav-link focus-ring text-sm font-medium px-3 py-2 rounded-full whitespace-nowrap">{t('nav.home')}</a></li>
      <li><a href="#skills" class="nav-link focus-ring text-sm font-medium px-3 py-2 rounded-full whitespace-nowrap">{t('nav.skills')}</a></li>
      <li><a href="#contact" class="nav-link focus-ring text-sm font-medium px-3 py-2 rounded-full whitespace-nowrap">{t('nav.contact')}</a></li>
    </ul>

    <div class="nav-divider hidden md:block w-px h-5 mx-1.5 shrink-0"></div>

    <div class="flex items-center gap-1 shrink-0">
      <ThemeToggle ariaLabel={t('theme.toggle')} />
      <LanguageSwitcher />
    </div>
  </nav>
</header>

<script>
  let headerAbort: AbortController | null = null;

  const HIDE_AFTER = 120;
  const SCROLL_DELTA = 6;

  let lastAnchor = 0;
  let suppressUntil = 0;
  let pendingHideAfterScroll = false;
  let scrollIdleTimer = 0;

  function setNavHidden(hidden: boolean) {
    const el = document.getElementById('header');
    if (!el) return;
    el.classList.toggle('nav-hidden', hidden);
  }

  function updateActiveLink() {
    const sections = document.querySelectorAll('section[id]');
    const navLinks = document.querySelectorAll('.nav-link');
    let current = '';

    sections.forEach((section) => {
      const top = (section as HTMLElement).offsetTop - 200;
      if (window.scrollY >= top) {
        current = section.getAttribute('id') || '';
      }
    });

    navLinks.forEach((link) => {
      const href = link.getAttribute('href')?.substring(1);
      if (href === current) {
        link.classList.add('active');
      } else {
        link.classList.remove('active');
      }
    });
  }

  function toggleGlassNav() {
    const desktopNav = document.getElementById('desktop-nav');
    const scrolled = window.scrollY > 80;

    if (!desktopNav) return;
    if (scrolled) {
      desktopNav.classList.add('nav-scrolled');
    } else {
      desktopNav.classList.remove('nav-scrolled');
    }
  }

  function updateNavVisibility() {
    const y = Math.max(window.scrollY, 0);

    if (Date.now() < suppressUntil || y <= HIDE_AFTER) {
      setNavHidden(false);
      lastAnchor = y;
      return;
    }

    const diff = y - lastAnchor;
    if (diff > SCROLL_DELTA) {
      setNavHidden(true);
      lastAnchor = y;
    } else if (diff < -SCROLL_DELTA) {
      setNavHidden(false);
      lastAnchor = y;
    }
  }

  // Once a programmatic scroll (nav click) settles, dismiss the nav
  function onScrollIdle() {
    if (!pendingHideAfterScroll) return;
    pendingHideAfterScroll = false;
    suppressUntil = 0;
    setNavHidden(true);
  }

  function smoothScrollTo(targetId: string) {
    const target = document.getElementById(targetId);
    if (!target) return;

    // Sections are full-viewport height (min-h-[100dvh]): align the section
    // top with the viewport top so the entire section is visible at once.
    const targetPosition = target.getBoundingClientRect().top + window.pageYOffset;

    // Already there: dismiss the nav right away
    if (Math.abs(window.pageYOffset - targetPosition) < 4) {
      pendingHideAfterScroll = false;
      setNavHidden(true);
      return;
    }

    // Keep the nav visible while the smooth scroll runs, then hide it on arrival
    suppressUntil = Date.now() + 2000;
    pendingHideAfterScroll = true;
    setNavHidden(false);

    window.scrollTo({
      top: targetPosition,
      behavior: 'smooth',
    });
  }

  function initHeader() {
    headerAbort?.abort();
    headerAbort = new AbortController();
    const signal = headerAbort.signal;

    lastAnchor = Math.max(window.scrollY, 0);
    pendingHideAfterScroll = false;
    window.clearTimeout(scrollIdleTimer);
    setNavHidden(false);

    toggleGlassNav();
    updateActiveLink();

    window.addEventListener(
      'scroll',
      () => {
        toggleGlassNav();
        updateActiveLink();
        updateNavVisibility();

        window.clearTimeout(scrollIdleTimer);
        scrollIdleTimer = window.setTimeout(onScrollIdle, 140);
      },
      { passive: true, signal }
    );

    // Keep the nav reachable for keyboard users: reveal it on focus
    const headerEl = document.getElementById('header');
    headerEl?.addEventListener(
      'focusin',
      () => {
        suppressUntil = Date.now() + 500;
        setNavHidden(false);
      },
      { signal }
    );

    // Let other components (e.g. the hero CTA) drive a programmatic scroll:
    // keep the nav visible while it runs, then dismiss it on arrival
    window.addEventListener(
      'nav:release',
      () => {
        suppressUntil = Date.now() + 2000;
        pendingHideAfterScroll = true;
        setNavHidden(false);
      },
      { signal }
    );

    // Desktop nav links
    document.querySelectorAll('.nav-link').forEach((link) => {
      link.addEventListener(
        'click',
        (e) => {
          e.preventDefault();
          const href = link.getAttribute('href')?.substring(1);
          if (href) smoothScrollTo(href);
        },
        { signal }
      );
    });
  }

  document.addEventListener('astro:page-load', initHeader);
  document.addEventListener('DOMContentLoaded', initHeader);
</script>
