  class="fixed bottom-8 right-8 z-40 w-14 h-14 rounded-full flex items-center justify-center"
  aria-label="Volver arriba"
  style="opacity:0; visibility:hidden; transition: opacity 0.3s ease, visibility 0.3s ease; backdrop-filter: blur(20px) saturate(165%); -webkit-backdrop-filter: blur(20px) saturate(165%); background: rgba(255,255,255,0.45); border: 1px solid rgba(255,255,255,0.5); box-shadow: 0 8px 32px rgba(0,0,0,0.06), inset 0 1px 0 rgba(255,255,255,0.6);"
>
  <svg class="w-6 h-6 text-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="3" aria-hidden="true">
    <path stroke-linecap="round" stroke-linejoin="round" d="M5 15l7-7 7 7"></path>
