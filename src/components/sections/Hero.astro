---
import Button from '@/components/Button.astro';
import { useTranslations, getCVPath } from '@/i18n/utils';
import type { Language } from '@/config/i18n';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const cvPath = getCVPath(lang);
---

<section class="text-center px-2">
  <p class="text-primary-600 dark:text-primary-400 font-medium mb-4 text-sm md:text-base">
    {t('hero.greeting')}
  </p>

  <div class="mb-6">
    <h2 class="text-4xl md:text-5xl tracking-tight text-primary-900 dark:text-primary-100">
      Daniel Miranda
      <span class="hero-role text-base md:text-lg font-medium text-secondary-600 dark:text-secondary-400">
        {t('hero.subtitle')}
      </span>
    </h2>
  </div>

  <p class="text-base text-secondary-700 dark:text-secondary-300 mb-10 max-w-2xl mx-auto leading-relaxed">
    {t('hero.description')}
  </p>

  <div class="flex gap-4 justify-center flex-wrap">
    <a href="#contact" class="hero-scroll-link">
      <Button variant="primary" size="lg">
        {t('hero.contact')}
      </Button>
    </a>
    <a href={cvPath} target="_blank" rel="noopener noreferrer">
      <Button variant="outline" size="lg">
        {t('nav.cv')}
      </Button>
    </a>
  </div>
</section>

<script>
  let scrollAbort: AbortController | null = null;

  function initHeroScroll() {
    scrollAbort?.abort();
    scrollAbort = new AbortController();
    const signal = scrollAbort.signal;

    document.querySelectorAll('.hero-scroll-link').forEach((link) => {
      link.addEventListener(
        'click',
        (e) => {
          e.preventDefault();
          window.dispatchEvent(new Event('nav:release'));
          const href = link.getAttribute('href')?.substring(1);
          const target = document.getElementById(href || '');
          if (target) {
            const top = target.getBoundingClientRect().top + window.pageYOffset;
            window.scrollTo({ top, behavior: 'smooth' });
          }
        },
        { signal }
      );
    });
  }

  document.addEventListener('astro:page-load', initHeroScroll);
  document.addEventListener('DOMContentLoaded', initHeroScroll);
</script>

<style>
  h2 {
    line-height: 1.2;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 0.4rem;
  }

  .hero-role {
    font-family: var(--font-sans);
    letter-spacing: -0.01em;
  }

  @media (max-width: 768px) {
    h2 {
      font-size: 2rem;
      gap: 0.15rem;
    }
  }
</style>
