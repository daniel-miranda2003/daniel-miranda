---
import { useTranslations } from '@/i18n/utils';
import type { Language } from '@/config/i18n';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section>
  <div class="max-w-5xl mx-auto text-center">
    <h2 class="text-3xl md:text-4xl tracking-tight mb-6 text-foreground">
      {t('contact.title')}
    </h2>
    
    <p class="text-base text-muted-foreground mb-3">
      {t('contact.subtitle')}
    </p>

    <p class="text-sm text-muted-foreground mb-12">
      {t('contact.availability')}
    </p>
    
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-12 md:items-stretch">
      <div class="flex">
        <a
          href="mailto:danielmiranda18lapaz@gmail.com"
          class="focus-ring relative flex flex-col flex-1 lg-card p-7 pt-8 overflow-hidden"
        >
          <div class="absolute top-8 right-6 w-28 h-28 bg-primary-400/10 dark:bg-primary-500/10 rounded-full blur-2xl pointer-events-none"></div>
          <h3 class="relative text-base font-semibold text-foreground mb-2">
            {lang === 'es' ? 'Correo Electrónico' : 'Email'}
          </h3>
          <p class="relative text-sm text-muted-foreground leading-relaxed">
            danielmiranda18lapaz@gmail.com
          </p>
        </a>
      </div>

      <div class="flex">
        <a
          href="https://wa.me/59175875587"
          target="_blank"
          rel="noopener noreferrer"
          class="focus-ring relative flex flex-col flex-1 lg-card p-7 pt-8 overflow-hidden"
        >
          <div class="absolute top-8 right-6 w-28 h-28 bg-secondary-500/08 rounded-full blur-2xl pointer-events-none"></div>
          <h3 class="relative text-base font-semibold text-foreground mb-2">
            {lang === 'es' ? 'Celular' : 'Phone'}
          </h3>
          <p class="relative text-sm text-muted-foreground leading-relaxed">
            (+591) 75875587
          </p>
        </a>
      </div>
    </div>
    
    <div>
      <p class="text-sm font-semibold text-secondary-600 dark:text-secondary-400 mb-8">
        {lang === 'es' ? 'Sígueme en' : 'Follow me on'}
      </p>
      
      <div class="flex justify-center gap-6 flex-wrap font-mono text-sm">
        <a
          href="https://github.com/daniel-miranda2003"
          target="_blank"
          rel="noopener noreferrer"
          class="focus-ring text-foreground"
        >
          <span aria-hidden="true">[</span>GitHub<span aria-hidden="true">]</span>
        </a>

        <a
          href="https://bo.linkedin.com/in/luis-daniel-miranda-machaca-b7a033222"
          target="_blank"
          rel="noopener noreferrer"
          class="focus-ring text-foreground"
        >
          <span aria-hidden="true">[</span>LinkedIn<span aria-hidden="true">]</span>
        </a>

        <a
          href="https://x.com/danieelmi"
          target="_blank"
          rel="noopener noreferrer"
          class="focus-ring text-foreground"
        >
          <span aria-hidden="true">[</span>X<span aria-hidden="true">]</span>
        </a>
      </div>
    </div>
  </div>
</section>
