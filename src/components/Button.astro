---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'outline';
  size?: 'sm' | 'md' | 'lg';
  class?: string;
}

const { 
  href, 
  variant = 'primary', 
  size = 'md',
  class: className = '' 
} = Astro.props;

const baseClasses = 'button-base inline-flex items-center justify-center font-semibold rounded-full cursor-pointer';

const sizeClasses = {
  sm: 'py-2 px-5 text-sm',
  md: 'py-3 px-7 text-base',
  lg: 'py-3.5 px-9 text-lg',
};

const Tag = href ? 'a' : 'button';
---

<Tag href={href} class:list={[baseClasses, `button-${variant}`, sizeClasses[size], className]}>
  <slot />
</Tag>

<style>
  .button-base {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    transition: all 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  /* Primary — solid gradient */
  .button-primary {
    background: linear-gradient(135deg, var(--color-primary-600), var(--color-primary-400));
    color: white;
    border: 1px solid rgba(255, 255, 255, 0.2);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.25),
      0 8px 24px rgba(6, 182, 212, 0.25);
  }

  .button-primary::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(135deg, rgba(255,255,255,0.25), transparent 50%);
    pointer-events: none;
    z-index: -1;
  }

  .button-primary:hover {
    transform: translateY(-2px);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.3),
      0 12px 32px rgba(6, 182, 212, 0.35);
  }

  .button-primary:active {
    transform: translateY(0) scale(0.97);
  }

  /* Secondary — muted solid */
  .button-secondary {
    background: linear-gradient(135deg, var(--color-secondary-600), var(--color-secondary-400));
    color: white;
    border: 1px solid rgba(255, 255, 255, 0.15);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.2),
      0 8px 24px rgba(100, 116, 139, 0.2);
  }

  .button-secondary::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(135deg, rgba(255,255,255,0.2), transparent 50%);
    pointer-events: none;
    z-index: -1;
  }

  .button-secondary:hover {
    transform: translateY(-2px);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.25),
      0 12px 32px rgba(100, 116, 139, 0.3);
  }

  .button-secondary:active {
    transform: translateY(0) scale(0.97);
  }

  /* Outline — liquid glass */
  .button-outline {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    border-radius: 999px;
    border: 1px solid var(--lg-border);
    background:
      linear-gradient(135deg, var(--lg-sheen), transparent 50%),
      var(--lg-tint);
    backdrop-filter: blur(var(--lg-blur)) saturate(var(--lg-saturate)) brightness(var(--lg-brightness));
    -webkit-backdrop-filter: blur(var(--lg-blur)) saturate(var(--lg-saturate)) brightness(var(--lg-brightness));
    color: var(--color-foreground);
    box-shadow:
      var(--lg-inset-rim),
      var(--lg-shadow);
  }

  .button-outline::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background:
      radial-gradient(ellipse at 25% -5%, var(--lg-sheen) 0%, transparent 45%);
    pointer-events: none;
    z-index: -1;
  }

  .button-outline::after {
    content: '';
    position: absolute;
    inset: 1px;
    border-radius: inherit;
    border: 1px solid var(--lg-border-subtle);
    pointer-events: none;
    z-index: -1;
  }

  .button-outline:hover {
    border-color: var(--lg-border);
    box-shadow:
      var(--lg-inset-rim),
      var(--lg-shadow-lg);
    transform: translateY(-2px);
  }

  .button-outline:active {
    transform: translateY(0) scale(0.97);
  }
</style>
