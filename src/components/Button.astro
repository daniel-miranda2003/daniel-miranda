---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'outline';
  size?: 'sm' | 'md' | 'lg';
  class?: string;
}

const { 
  href, 
  variant = 'primary', 
  size = 'md',
  class: className = '' 
} = Astro.props;

const baseClasses = 'button-base inline-flex items-center justify-center font-semibold rounded-full cursor-pointer';

const sizeClasses = {
  sm: 'py-2 px-4 text-sm',
  md: 'py-2.5 px-6 text-sm',
  lg: 'py-3 px-7 text-base',
};

const Tag = href ? 'a' : 'button';
---

<Tag href={href} class:list={[baseClasses, `button-${variant}`, sizeClasses[size], className]}>
  <slot />
</Tag>

<style>
  .button-base {
    position: relative;
    isolation: isolate;
    overflow: hidden;
  }

  .button-base:focus-visible {
    outline: 2px solid var(--color-foreground);
    outline-offset: 3px;
  }

  .button-primary {
    background: linear-gradient(135deg, #262626, #161616);
    color: #f7f7f7;
    border: 1px solid rgba(255, 255, 255, 0.14);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.22),
      0 8px 24px rgba(0, 0, 0, 0.28);
  }

  .button-primary::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(135deg, rgba(255,255,255,0.18), transparent 50%);
    pointer-events: none;
    z-index: -1;
  }

  :global(.dark) .button-primary {
    background: linear-gradient(135deg, #fafafa, #e2e2e2);
    color: #161616;
    border-color: rgba(0, 0, 0, 0.25);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.8),
      0 8px 24px rgba(0, 0, 0, 0.55);
  }

  :global(.dark) .button-primary::before {
    background: linear-gradient(135deg, rgba(0,0,0,0.06), transparent 50%);
  }

  .button-secondary {
    background: linear-gradient(135deg, var(--color-secondary-600), var(--color-secondary-700));
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.15);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.2),
      0 8px 24px rgba(0, 0, 0, 0.2);
  }

  .button-secondary::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(135deg, rgba(255,255,255,0.2), transparent 50%);
    pointer-events: none;
    z-index: -1;
  }

  :global(.dark) .button-secondary {
    background: linear-gradient(135deg, #2e2e2e, #242424);
    color: #ededed;
    border-color: rgba(255, 255, 255, 0.12);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.1),
      0 8px 24px rgba(0, 0, 0, 0.5);
  }

  .button-outline {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    border-radius: 999px;
    border: 1px solid var(--lg-border);
    background:
      linear-gradient(135deg, var(--lg-sheen), transparent 50%),
      var(--lg-tint);
    backdrop-filter: blur(var(--lg-blur)) saturate(var(--lg-saturate)) brightness(var(--lg-brightness));
    -webkit-backdrop-filter: blur(var(--lg-blur)) saturate(var(--lg-saturate)) brightness(var(--lg-brightness));
    color: var(--color-foreground);
    box-shadow:
      var(--lg-inset-rim),
      var(--lg-shadow);
  }

  .button-outline::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background:
      radial-gradient(ellipse at 25% -5%, var(--lg-sheen) 0%, transparent 45%);
    pointer-events: none;
    z-index: -1;
  }

  .button-outline::after {
    content: '';
    position: absolute;
    inset: 1px;
    border-radius: inherit;
    border: 1px solid var(--lg-border-subtle);
    pointer-events: none;
    z-index: -1;
  }
</style>
